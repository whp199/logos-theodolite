# The census volunteer kit's fixed settings (VOLUNTEERS.md). scripts/volunteer/census.sh sources this file;
# backend/census_volunteer.py reads it for scripts/volunteer/volunteer_tool.py, scripts/census_board.py and
# scripts/census_intake.py. Every layer a volunteer takes is the home card's layer 45 run's command at another layer
# (experiments/results/census_L45_whole/), so the layers stand side by side. A change of any value here is a new kit: raise
# KIT, tag the commit census-kit-<KIT>, take the home canaries again (scripts/census_intake.py home-canaries).
KIT=1
KIT_TAG=census-kit-1
# the layers the kit takes, counting from 0 (page = layer + 1): break_rel's doses are calibrated at 40-50 alone
# (census.DOSES_CALIBRATED), and 45 is taken
KIT_LAYERS="40 41 42 43 44 46 47 48 49 50"
KIT_DESIGN=break_rel
KIT_NEURONS=all
KIT_CONTROLS=2048
KIT_SEED=7
KIT_BATCH=64
KIT_MAX_NEW=48
KIT_UNPACKER=compiled
# the home venv's exact versions (scripts/export_constraints.sh), the stats index the push's unit is read from
KIT_CONSTRAINTS=scripts/pod/constraints/home-2026-10-30.txt
KIT_ACT_SCALE_SHA256=23a6dcefaf4eae99222c334a8294f773e37e4f20cbf36b63344a73fd5c2911fa
KIT_ACT_SCALE_URL=https://github.com/whp199/logos-theodolite/releases/download/census-kit-1/act_scale.npz
# where claims are posted and the board is kept (the pinned issue, once made: scripts/census_board.py publish --create)
KIT_BOARD_URL=https://github.com/whp199/logos-theodolite/issues
# what a machine needs: one card holding the model (about 22 GB) and a batch of 64 (about 5 GB more), and the disk for
# the checkpoint, the lenses, the venv and a run
KIT_MIN_VRAM_MIB=31000
KIT_MIN_DISK_GB=60
KIT_MIN_CUDA=13.0
# on the CPU stand-in (census.sh --dry-run, scripts/check_volunteer_kit.py): its 6 layers, 128 neurons a layer
KIT_DRY_LAYERS="2 3"
KIT_DRY_NEURONS=0-11
KIT_DRY_CONTROLS=4
KIT_DRY_BATCH=4
KIT_DRY_MAX_NEW=8
